// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client-js"
  output          = "../generated/prisma/client"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  customer
  provider
}

enum AvailabilityStatus {
  available
  booked
}

enum BookingStatus {
  active
  ongoing
  cancelled
  returned
}

model User {
  id         Int       @id @default(autoincrement())
  name       String    @db.VarChar(255)
  email      String    @unique @db.VarChar(255)
  password   String    @db.VarChar(255)
  phone      String    @db.VarChar(15)
  role       UserRole
  bookings   Booking[]
  vehicles   Vehicle[]
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  @@map("users")
}

model Vehicle {
  id                  Int                @id @default(autoincrement())
  vehicle_name        String             @db.VarChar(255)
  brand               String?            @db.VarChar(100)
  description         String?            @db.Text
  type                String             @db.VarChar(100)
  fuel_type           String?            @db.VarChar(50)
  transmission        String?            @db.VarChar(50)
  passenger_capacity  Int?               @default(4)
  registration_number String             @unique @db.VarChar(100)
  daily_rent_price    Decimal            @db.Decimal(10, 2)
  availability_status AvailabilityStatus @default(available)
  image_url           String?            @db.Text
  bookings            Booking[]
  owner               User               @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  owner_id            Int
  created_at          DateTime           @default(now())
  updated_at          DateTime           @updatedAt

  @@map("vehicles")
}

model Booking {
  id              Int           @id @default(autoincrement())
  customer        User          @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  customer_id     Int
  vehicle         Vehicle       @relation(fields: [vehicle_id], references: [id], onDelete: Cascade)
  vehicle_id      Int
  rent_start_date DateTime      @db.Timestamp
  rent_end_date   DateTime      @db.Timestamp
  total_price     Decimal       @db.Decimal(10, 2)
  status          BookingStatus @default(active)

  @@map("bookings")
}
